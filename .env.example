# Сервер талын тохиргоо (Vite-ийн VITE_* хувьсагч БИШ — client bundle-д орохгүй).
# Энэ файлыг `.env` болгон хуулж, утгыг бөглөнө. `.env`-ыг commit хийхгүй.

# Google AI Studio-гийн Gemini API key. Байхгүй бол AI endpoint 503 буцаана.
GEMINI_API_KEY=

# Анхдагч: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Локал API серверийн порт (Vite /api-г энэ рүү proxy хийнэ).
API_PORT=8787
