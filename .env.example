# Сервер талын тохиргоо (Vite-ийн VITE_* хувьсагч БИШ — client bundle-д орохгүй).
# Энэ файлыг `.env` болгон хуулж, утгыг бөглөнө. `.env`-ыг commit хийхгүй.

# Google AI Studio-гийн Gemini API key. Байхгүй бол AI endpoint 503 буцаана.
GEMINI_API_KEY=

# Анхдагч: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Локал API серверийн порт (Vite /api-г энэ рүү proxy хийнэ).
API_PORT=8787

# Урд байгаа найдвартай proxy-ийн тоо. 0 = X-Forwarded-For-д огт итгэхгүй
# (шууд Node сервер / локал dev). Vercel-ийн нэг edge proxy үед 1.
# Бодит deployment-ийн дараа header-ээр баталж тохируулна.
TRUSTED_PROXY_HOPS=0

# Олон instance-тэй production-д rate limit-ыг хуваалцах Redis REST эндпоинт
# (Upstash-compatible). Хоосон бол instance-local memory горим.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
# Түлхүүрийн namespace. Нэг Redis-ийг preview/production хуваалцвал ялгана
# (жишээ нь: ratelimit-prod). Анхдагч: ratelimit:
RATE_LIMIT_REDIS_PREFIX=
