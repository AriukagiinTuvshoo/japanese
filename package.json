{
  "name": "nihongo-dojo",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Nihongo Dōjō — Монгол хэл дээрх Japan хэлний N5→N1 сургалтын платформ",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:validate && tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:all": "npm run data:fetch && npm run data:build && npm run data:validate",
    "test:routes": "node scripts/test-routes.mjs",
    "server": "node server/index.mjs",
    "coverage:report": "node scripts/validate-coverage.mjs --report --write",
    "coverage:validate": "node scripts/validate-coverage.mjs",
    "content:validate": "node scripts/validate-learning-libraries.mjs",
    "translations:apply": "node scripts/apply-translation-batches.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test": "npm run test:routes && npm run test:coverage && npm run test:retention && node scripts/test-grammar-mn-pending.mjs && npm run test:pwa && npm run test:tutor && npm run test:study && npm run test:runner-browser",
    "test:retention": "node scripts/test-source-retention.mjs",
    "test:admin-browser": "ADMIN_TEST_START_SERVER=1 node scripts/test-admin-browser.mjs",
    "test:site-browser": "node scripts/test-site-browser.mjs",
    "test:study": "node scripts/test-study.mjs",
    "test:runner-browser": "node scripts/test-runner-browser.mjs",
    "test:pwa": "node scripts/test-pwa.mjs",
    "test:pwa-smoke": "node scripts/test-pwa-smoke.mjs",
    "test:tutor": "node scripts/test-tutor.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.64.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
