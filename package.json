{
  "name": "nihongo-dojo",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Nihongo Dōjō — Монгол хэл дээрх Japan хэлний N5→N1 сургалтын платформ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "data:fetch": "node scripts/fetch-sources.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "content:qa": "node scripts/content-qa.mjs",
    "fonts:build": "node scripts/build-fonts.mjs",
    "fonts:check": "node scripts/check-font-coverage.mjs",
    "test:sw": "node scripts/test-sw.mjs",
    "test:e2e": "node e2e/run.mjs",
    "data:all": "npm run data:fetch && npm run data:build && npm run data:validate",
    "test:routes": "node scripts/test-routes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "node server/index.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "^1.56.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vitest": "^3.2.7"
  }
}
